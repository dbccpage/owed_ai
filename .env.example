# Copy to .env. Never commit real credentials. Process environment wins.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
COMPATIBLE_API_KEY=
# anthropic | openrouter | compatible | local
WORKBENCH_PROVIDER=openrouter
# Explicit provider model ID; there is deliberately no automatic model selection.
WORKBENCH_MODEL=
# Optional override; local defaults to http://localhost:11434/v1
WORKBENCH_BASE_URL=
# json_schema for supported models, otherwise json_prompt (both validated locally)
WORKBENCH_OUTPUT_MODE=json_prompt
# compatible endpoints use only this explicitly selected variable
WORKBENCH_KEY_ENV=COMPATIBLE_API_KEY
WORKBENCH_DATA_DIR=data

# Local mode is for your own machine. Render always requires hosted mode.
WORKBENCH_MODE=local
# Hosted settings are documented in docs/deployment.md and render.yaml.
WORKBENCH_LIVE_ENABLED=false
WORKBENCH_PUBLIC_URL=https://workbench.anomalon.com
WORKBENCH_AUTH_ISSUER=https://accounts.google.com
WORKBENCH_AUTH_CLIENT_ID=
WORKBENCH_AUTH_CLIENT_SECRET=
WORKBENCH_COOKIE_SECRET=
WORKBENCH_ALLOWED_SUBJECTS=[]
WORKBENCH_HOSTED_MODEL=openai/gpt-4.1-mini
